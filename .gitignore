# Models and weights (never commit — too large)
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
jaeger_agent_omni/nodes/*/weights/
gates/*/weights/

# Local secrets
.env
.env.*
!.env.example

# Operator/instance state, if this repo ever runs standalone
.jaeger_os/

# Template-only ignores. An INSTANTIATED repo commits its real config —
# JaegerWhisperSTT tracks both pyproject.toml and module.yaml. Removed the
# pyproject.toml ignore for that reason.
# Real (non-example) config generated from the .example templates —
# keep the templates tracked, never the filled-in versions.
.DS_Store

# Training checkpoints — big, reproducible from configs/ + the corpus.
training/runs/
artifacts/stock-whisper-gemma-*.npz
artifacts/stock-whisper-large*.npz

# Local corpora and generated teacher tensors. Canonical training data lives
# under ~/models/jaeger-training-data; these are caches, not source code.
training/corpus_e4b/
training/corpus_real/
training/corpus_mixed/
research/talker_emb_text.npy
research/teacher12_20260821/
research/teacher_librispeech64_20260821/

# Third-party sources kept locally for reading, never vendored.
reference/*
!reference/README.md

# Audio samples are large and are inputs, not source.
training/samples/*.wav
training/samples/*.mp3

# Full-duplex demo state (captures may contain private room audio).
Full DuplexDemo App/runtime/

# All checkpoint/port artifacts — 19 GB of weights; JSON evidence lives in
# research/candidate_evals and research/results instead.
artifacts/

# AEC path-probe waveform dumps: room audio captures, keep local.
research/results/aec-path-*/
